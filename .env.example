# Baton environment — placeholder values ONLY. Never put a real key here.
# Copy to .env when wiring the real Nebius adapter (later session).

# Nebius Token Factory (OpenAI-compatible). Unused in Session 1: extraction is stubbed.
NEBIUS_API_KEY=your-token-factory-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA open models served by Token Factory.
# Reasoning default verified against the live models list. Summary default is
# the verified served id: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B. The older
# nvidia/nemotron-3-nano-30b-a12b is NOT a served model id; do not use it.
NEBIUS_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_SUMMARY=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Extraction backend: "stub" (offline default) or "nebius" (real LLM pass).
# Also selectable per-run: baton recover bundle.json --extractor nebius
BATON_EXTRACTOR=stub

# Generous token budget for extraction: Nemotron spends output tokens on
# reasoning before content, so a small budget starves real prompts.
NEBIUS_MAX_TOKENS=2048

# Cost guard (see baton/cost.py). Session 1 runs offline on fixtures.
BATON_MAX_INPUT_CHARS=120000
BATON_DAILY_TOKEN_CAP=200000
